{
  "name": "nms-crafting-handbook",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (EN/PT-BR) No Man's Sky crafting, refining and cooking handbook",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
