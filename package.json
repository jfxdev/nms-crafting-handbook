    "dompurify": "^3.4.15",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
